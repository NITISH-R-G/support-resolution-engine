# Copy to .env and fill in. .env is gitignored and must never be committed.
#   cp .env.example .env
#
# Nothing in this project reads a key from source. If a key is not in the environment, the
# NullProvider raises and the deterministic generator runs instead — at zero cost.

# ----------------------------------------------------------------- provider selection
# null              (default) no API calls, deterministic evidence-template generator only
# openrouter        OpenRouter, one key for many models
# groq              Groq (OpenAI-compatible), very fast inference
# openai_compatible any OpenAI-shaped endpoint, including a local one (set LLM_BASE_URL)
# anthropic         Anthropic direct — keep for the judge, so it is a different model family
#                   from the generator (leakage.assert_independent_models requires this)
LLM_PROVIDER=openrouter

# ----------------------------------------------------------------- credentials
# Get an OpenRouter key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Get a Groq key at https://console.groq.com/keys
GROQ_API_KEY=

# Each named provider reads its OWN variable (openrouter -> OPENROUTER_API_KEY, groq ->
# GROQ_API_KEY, anthropic -> ANTHROPIC_API_KEY, openai -> OPENAI_API_KEY), falling back
# only to the generic LLM_API_KEY. Set only the one you need.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# LLM_API_KEY=            # generic: also what an OmniRoute / self-hosted gateway uses

# ----------------------------------------------------------------- model
# Any model id your provider exposes. Nothing in the code hardcodes one, and no paid model is
# ever the only option. OpenRouter ids look like "vendor/model".
#
# Free / very cheap, good for the first smoke test:
#   meta-llama/llama-3.3-70b-instruct
#   google/gemini-2.0-flash-001
#   mistralai/mistral-small
# Stronger, for the A/B comparison:
#   anthropic/claude-sonnet-4.5
#   openai/gpt-4.1
# Verified working on Groq (2026-09-11): openai/gpt-oss-120b, openai/gpt-oss-20b,
# qwen/qwen3.8-27b, groq/compound-mini. List yours: GET <base_url>/models
LLM_MODEL=openai/gpt-oss-120b

# Override for a non-OpenRouter endpoint (a local llama.cpp/vLLM server, Azure, etc.)
# LLM_BASE_URL=http://localhost:8000/v1
# OmniRoute is an OpenAI-compatible gateway and needs no provider-specific code:
#   LLM_PROVIDER=openai_compatible
#   LLM_BASE_URL=http://localhost:20128/v1   (its default host/port)
#   LLM_API_KEY=<key from its dashboard, Endpoints section>

# ----------------------------------------------------------------- determinism
# Temperature 0 and a fixed seed, so a cache miss during evaluation is still reproducible.
# Set LLM_SEED=none to disable seeding for providers that reject the parameter.
LLM_TEMPERATURE=0.0
LLM_SEED=20260911
# Reasoning models spend most of this budget on reasoning BEFORE emitting any JSON.
# Measured: openai/gpt-oss-20b needs ~1400 output tokens for one reply; at 600 it
# returns HTTP 400 json_validate_failed with an empty generation. Use 4000 for
# reasoning models; 600 is fine for non-reasoning ones.
LLM_MAX_TOKENS=4000

# ----------------------------------------------------------------- reliability
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3

# ----------------------------------------------------------------- cost accounting
# Per million tokens, in USD, from your provider's pricing page. If unset, cost is reported as
# "unknown" rather than as $0.00 — a zero that is really a gap understates spend.
# LLM_PRICE_IN_PER_MTOK=0.30
# LLM_PRICE_OUT_PER_MTOK=0.60

# ----------------------------------------------------------------- logging
# One JSON line per call. Records a prompt HASH, tokens, cost, latency and attempts — never
# the API key. Prompt text is omitted by default because prompts carry customer messages.
LLM_LOG_PATH=reports/llm_calls.jsonl
# Set to 1 only when debugging a prompt, and remember the log then contains customer text.
LLM_LOG_PROMPTS=0

# Raw and derived data are never committed; reviewers reproduce them via scripts/fetch_data.py
data/raw/
data/processed/
data/interim/
*.csv
!tests/fixtures/*.csv
!data/golden/*.csv
# Derived analysis artifacts are small, reproducible and part of the project record.
!reports/*.csv

# Model artifacts and caches
*.pkl
*.joblib
*.faiss
.cache/
cache/llm/

# Reviewer exports: derived from the corpus, never committed
exports/

# Full-text rebuilds (tweet text: customer messages, brand replies, model replies). The repository
# stores only ids, labels and hashes; scripts/materialize_text.py recreates these locally.
data/local/

# Secrets
.env
.env.*
!.env.example
kaggle.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/
build/
dist/
